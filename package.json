{
  "name": "baliktela-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "analytics:poc:generate": "tsx scripts/generate-predictive-dataset.ts",
    "security:audit": "node --import tsx scripts/audit-security.ts",
    "test:security:ui": "node --import tsx scripts/test-security-ui.ts",
    "test:predictive:ui": "node --import tsx scripts/test-predictive-ui.ts",
    "test:reports:ui": "node --import tsx scripts/test-reports-ui.ts",
    "start": "node build/server/index.js",
    "build:server": "tsc -p tsconfig.build.json",
    "build:render": "npm run build && npm run build:server",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "test": "tsx --test server/*.test.ts server/database/*.test.ts",
    "test:auth": "npm run build:render && tsx scripts/test-authentication.ts",
    "test:auth:ui": "node scripts/test-auth-ui.mjs",
    "test:auth:branding": "node scripts/test-auth-branding.mjs",
    "test:dashboard:ui": "node --import tsx scripts/test-dashboard-ui.ts",
    "test:analytics:ui": "node --import tsx scripts/test-material-evidence-ui.ts",
    "test:web-corrections:ui": "node --import tsx scripts/test-web-corrections-ui.ts",
    "test:imports:ui": "node --import tsx scripts/test-bulk-import-ui.ts",
    "test:stakeholders:ui": "node --import tsx scripts/test-stakeholders-ui.ts",
    "test:governance:ui": "node --import tsx scripts/test-governance-ui.ts",
    "test:hubs:ui": "node --import tsx scripts/test-hubs-ui.ts",
    "test:hubs:policy:ui": "node --import tsx scripts/test-hub-policy-ui.ts",
    "test:hubs:integration": "node --import tsx scripts/test-hub-integration.ts --rollback-only",
    "audit:mobile-web": "node --import tsx scripts/audit-mobile-web.ts",
    "test:mobile-alignment:ui": "node --import tsx scripts/test-mobile-alignment-ui.ts",
    "test:recovery:ui": "node --import tsx scripts/test-recovery-ui.ts",
    "test:traceability:ui": "node --import tsx scripts/test-traceability-ui.ts",
    "test:motion:ui": "node --import tsx scripts/test-motion-ui.ts",
    "test:session:ui": "node --import tsx scripts/test-session-invalidation-ui.ts",
    "test:home:ui": "node scripts/test-home-ui.mjs",
    "test:auth:supabase": "npm run build:render && tsx scripts/test-authentication.ts --supabase",
    "test:crud": "tsx scripts/test-management-crud.ts",
    "test:crud:ui": "node scripts/test-crud-ui.mjs",
    "test:crud:sql": "tsx scripts/test-management-sql.ts",
    "test:crud:supabase": "tsx scripts/test-supabase-crud.ts",
    "test:invitation:ui": "node scripts/test-invitation-ui.mjs",
    "test:invitation:sql": "tsx scripts/test-invitation-sql.ts",
    "test:invitation:supabase": "tsx scripts/test-supabase-invitation.ts",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "db:schema:check": "tsx scripts/database-schema.ts",
    "db:schema:apply": "tsx scripts/database-schema.ts --apply",
    "db:schema:additive": "tsx scripts/database-schema.ts --additive",
    "db:schema:export": "tsx scripts/export-database-schema.ts",
    "db:supabase:generate": "tsx scripts/generate-supabase-migration.ts",
    "db:supabase:check": "tsx scripts/supabase-schema.ts",
    "db:supabase:apply": "tsx scripts/supabase-schema.ts --apply",
    "db:supabase:seed": "tsx scripts/seed-database.ts",
    "db:supabase:seed-dashboard": "tsx scripts/seed-synthetic-dashboard.ts",
    "db:supabase:seed-october": "node --import tsx scripts/seed-october-dashboard.ts",
    "db:supabase:complete-demo": "node --import tsx scripts/complete-synthetic-lifecycles.ts",
    "db:supabase:test-sync": "tsx scripts/test-mobile-sync.ts",
    "db:supabase:test-auth": "npm run build:render && tsx scripts/test-supabase-auth.ts",
    "db:supabase:migrate-auth": "tsx scripts/migrate-demo-auth.ts",
    "auth:retire-demo": "tsx scripts/retire-demo-accounts.ts",
    "auth:provision-backup": "tsx scripts/provision-backup-admin.ts",
    "db:seed:demo": "tsx scripts/seed-database.ts",
    "db:test:mobile-sync": "tsx scripts/test-mobile-sync.ts",
    "generate:tracker": "node scripts/generate-feature-tracker.mjs",
    "generate:milestones": "node scripts/generate-milestone-plan.mjs",
    "build": "tsc -b && vite build && npm run security:audit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "^5.0.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "mongodb": "^7.6.0",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "simple-statistics": "^7.12.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "docx": "^9.8.0",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
