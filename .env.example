PORT=4000
# Optional public build-time app URL override. Defaults to the approved mobile web app.
# Never put credentials in VITE_ variables; they are visible in the browser.
VITE_MOBILE_APP_URL=
CLIENT_ORIGIN=http://localhost:5173
# Primary shared persistence. Keep the secret key on the API server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Direct or session-pooler PostgreSQL URI; used only by migration tooling.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:password@HOST:5432/postgres
SUPABASE_SCHEMA_APPLY=false
DATABASE_SEED_DEMO=false
DATABASE_SYNC_TEST=false
SUPABASE_AUTH_TEST=false

# Legacy migration source only. Remove after MongoDB data migration is accepted.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=baliktela_dev
# Optional JSON hostname-to-IP map for local DNS troubleshooting only.
MONGODB_HOST_OVERRIDES=
MONGODB_SEED_DEMO=false
MONGODB_SCHEMA_APPLY=false
MONGODB_SCHEMA_APPLIED_BY=local-developer
MONGODB_SYNC_TEST=false
SYNC_TEST_API_URL=http://127.0.0.1:4000/api
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_CHALLENGE_REQUEST_WINDOW_SECONDS=3600
AUTH_CHALLENGE_REQUEST_LIMIT=3
AUTH_DEMO_DELIVERY=false

# Shared read caches; successful web writes invalidate immediately.
# Mobile changes become visible when the short-lived caches expire.
DASHBOARD_SNAPSHOT_TTL_SECONDS=60
DASHBOARD_CACHE_TTL_SECONDS=30
DASHBOARD_PREWARM=false

# One-time owner commands only. Do not configure these on the web/Render runtime.
PRIMARY_ADMIN_EMAIL=
BACKUP_ADMIN_EMAIL=backup-admin@baliktela.internal
BACKUP_ADMIN_PASSWORD=
BACKUP_ADMIN_PROVISION=false
DEMO_ACCOUNTS_RETIRE=false
